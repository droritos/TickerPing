# ==============================================================================
# CALLMEBOT WHATSAPP SETUP (100% Free)
# 1. Save phone number +34 644 44 48 37 (or the active CallMeBot number) in your WhatsApp
# 2. Send the message: "I allow callmebot to send me messages"
# 3. CallMeBot will reply with your personal API key
# 4. Fill in your international phone number (e.g. +972501234567 or +1234567890) and API key below
# ==============================================================================

CALLMEBOT_PHONE=+1234567890
CALLMEBOT_APIKEY=your_callmebot_api_key_here

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# Data storage file
DATA_FILE_PATH=alarms.json
